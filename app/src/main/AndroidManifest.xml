<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      carBuddy is an Android Auto "parked app": an ordinary activity that Android
      Auto shows on the car screen while parked, on a display of the car screen's
      size. Current Android Auto rejects sideloaded Car App Library apps even with
      Unknown sources on, but accepts apps declared this way: the game category,
      CAR_LAUNCHER on the launcher activity, and automotive hardware optional.
      Only carBuddy itself may run there; Android Auto blocks other apps on that
      display, so carBuddy shows them through a mirror of the phone instead.
    -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- The streaming browser. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Screen capture runs in a foreground service of type mediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the phone screen on while mirroring; an off screen mirrors as black. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- So the car-side app list can show what is installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CarBuddyApp"
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="carBuddy"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Setup on the phone, the mirror on the car screen (see MainActivity).
             configChanges keeps it from restarting when the car display changes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- carBuddy Clock: the only screen declared distraction-optimised, so the
             only one meant to stay up while driving. It shows the time and date
             and nothing else, has nothing to operate, and runs in its own task so
             it cannot lead to the parked-only mirror or browser above. Keep it
             that way: anything added here must still meet in-car distraction
             guidelines, or this flag must come off. -->
        <activity
            android:name=".ClockActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:label="Clock"
            android:taskAffinity="com.davenn.carbuddy.clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- The streaming browser on the phone, mainly for signing in. -->
        <activity
            android:name=".BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="carBuddy browser"
            android:windowSoftInputMode="adjustResize" />

        <!-- Invisible; exists only to show the screen-capture prompt. -->
        <activity
            android:name=".ProjectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".TouchService"
            android:exported="true"
            android:label="@string/touch_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touch_service" />
        </service>
    </application>
</manifest>
